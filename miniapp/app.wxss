/* =========================================================
 * CareLink 竹苑益家人 · 全局主题（暖橙 #ff7a33 + 渐变）
 * 设计原则：
 *   — 所有主色/强调色统一走 --primary-color / --primary-gradient / --primary-light CSS 变量
 *   — 橙色背景上的文字固定使用 #fff 纯白，保障适老化对比度
 *   — 语义色保持独立：error/danger 红、text 深灰，不因换肤而变
 * =======================================================*/

page {
  /* 主题变量（暖橙渐变风） */
  --primary-color: #ff7a33;
  --primary-gradient: linear-gradient(180deg, #ff8c42 0%, #ff6b35 100%);
  --primary-light: rgba(255, 122, 51, 0.1);

  /* 语义色（不变） */
  --text-body: #1f2937;
  --text-muted: #9a3412;
  --bg-page: linear-gradient(180deg, rgba(255, 122, 51, 0.12) 0%, #ffffff 40%);

  background: var(--bg-page);
}

.page {
  min-height: 100vh;
  padding: 0 32rpx 32rpx 32rpx;
  box-sizing: border-box;
}

/* 顶部英雄区（暖橙渐变 Banner） */
.hero {
  padding: 40rpx 32rpx;
  margin: 0 -32rpx 12rpx;
  background: var(--primary-gradient);
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(255, 122, 51, 0.25);
}
.hero-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}
.hero-sub {
  margin-top: 8rpx;
  color: #ffffff;
  opacity: 0.92;
  font-size: 26rpx;
}

/* 卡片通用 */
.card {
  margin-top: 28rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(255, 122, 51, 0.08);
  border: 1rpx solid var(--primary-light);
}
.card-loading {
  text-align: center;
  color: var(--primary-color);
}
.card-error {
  text-align: center;
  color: #b91c1c;
  background: #fff5f5;
  border-color: #fecaca;
  box-shadow: 0 4rpx 24rpx rgba(185, 28, 28, 0.06);
}
.err-title {
  font-weight: 700;
  font-size: 30rpx;
  margin-bottom: 12rpx;
}
.err-msg {
  margin-bottom: 24rpx;
  color: #7f1d1d;
}

/* 统一按钮（主题绿 + 适老化大圆角） */
.btn {
  background: var(--primary-color);
  color: #ffffff !important;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 16rpx 0;
  border: none;
  box-shadow: 0 6rpx 18rpx rgba(255, 122, 51, 0.3);
}
.btn::after {
  border: none;
}

/* 行列表 */
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--primary-light);
}
.row:last-child {
  border-bottom: 0;
}
.k {
  color: var(--text-muted);
  font-size: 28rpx;
}
.v {
  color: var(--text-body);
  font-size: 28rpx;
  font-weight: 500;
}

/* 角色标签（浅橙底 + 深橙字） */
.tag {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: var(--primary-light);
  color: #7c2d12;
  font-size: 24rpx;
  font-weight: 600;
}
.tag.role {
  background: var(--primary-light);
  color: #9a3412;
}

/* 消费金余额（大字主题色金额） */
.price {
  color: var(--primary-color);
  font-size: 38rpx;
  font-weight: 800;
}

/* 提示区 */
.tips {
  margin-top: 40rpx;
  color: var(--text-muted);
  font-size: 24rpx;
  line-height: 1.7;
  opacity: 0.85;
  padding: 0 8rpx;
}
