/* =========================================================
 * CareLink 邻舍益家人 · 全局主题（极简灰蓝 #3b6291）
 * 设计原则：
 *   — 所有主色/强调色统一走 --primary-color / --primary-light CSS 变量
 *   — 页面采用浅灰底 #f7f8fa + 白色卡片，去除大面积渐变色块
 *   — 语义色保持独立：error/danger 红不因换肤而变
 * =======================================================*/

page {
  /* 主题变量（极简灰蓝） */
  --primary-color: #3b6291;
  --primary-light: #e6effa;

  /* 文字色 */
  --text-main: #333333;
  --text-muted: #999999;

  /* 背景 */
  --bg-page: #f7f8fa;

  background: var(--bg-page);
  color: var(--text-main);
}

.page {
  min-height: 100vh;
  padding: 0 32rpx 32rpx 32rpx;
  box-sizing: border-box;
}

/* 顶部英雄区（纯白卡片，替代旧渐变 Banner） */
.hero {
  padding: 40rpx 32rpx;
  margin: 0 -32rpx 12rpx;
  background: #ffffff;
  border-bottom-left-radius: 16rpx;
  border-bottom-right-radius: 16rpx;
  color: var(--text-main);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.hero-title {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--primary-color);
  letter-spacing: 2rpx;
}
.hero-sub {
  margin-top: 8rpx;
  color: var(--text-muted);
  font-size: 26rpx;
}

/* 卡片通用 */
.card {
  margin-top: 28rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #eef0f3;
}
.card-loading {
  text-align: center;
  color: var(--primary-color);
}
.card-error {
  text-align: center;
  color: #b91c1c;
  background: #fff5f5;
  border-color: #fecaca;
  box-shadow: 0 2rpx 12rpx rgba(185, 28, 28, 0.04);
}
.err-title {
  font-weight: 700;
  font-size: 30rpx;
  margin-bottom: 12rpx;
}
.err-msg {
  margin-bottom: 24rpx;
  color: #7f1d1d;
}

/* 统一按钮（主题蓝，去除渐变） */
.btn {
  background: var(--primary-color);
  color: #ffffff !important;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 16rpx 0;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(59, 98, 145, 0.18);
}
.btn::after {
  border: none;
}

/* 行列表 */
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef0f3;
}
.row:last-child {
  border-bottom: 0;
}
.k {
  color: var(--text-muted);
  font-size: 28rpx;
}
.v {
  color: var(--text-main);
  font-size: 28rpx;
  font-weight: 500;
}

/* 角色标签（浅蓝底 + 蓝灰字） */
.tag {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: var(--primary-light);
  color: var(--primary-color);
  font-size: 24rpx;
  font-weight: 600;
}
.tag.role {
  background: var(--primary-light);
  color: var(--primary-color);
}

/* 消费金余额（大字主题色金额） */
.price {
  color: var(--primary-color);
  font-size: 38rpx;
  font-weight: 800;
}

/* 提示区 */
.tips {
  margin-top: 40rpx;
  color: var(--text-muted);
  font-size: 24rpx;
  line-height: 1.7;
  opacity: 0.85;
  padding: 0 8rpx;
}
