.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff7ed 0%, #ffffff 40%);
  padding: 32rpx;
  box-sizing: border-box;
}

.hero {
  padding: 32rpx 8rpx 12rpx;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #92400e;
}
.hero-sub {
  margin-top: 8rpx;
  color: #b45309;
  font-size: 26rpx;
}

.card {
  margin-top: 28rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(146, 64, 14, 0.06);
}
.card-loading {
  text-align: center;
  color: #b45309;
}
.card-error {
  text-align: center;
  color: #b91c1c;
}
.err-title {
  font-weight: 700;
  font-size: 30rpx;
  margin-bottom: 12rpx;
}
.err-msg {
  margin-bottom: 24rpx;
  color: #7f1d1d;
}

.btn {
  background: #f59e0b;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #fde68a;
}
.row:last-child {
  border-bottom: 0;
}
.k {
  color: #78350f;
  font-size: 28rpx;
}
.v {
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 500;
}
.tag {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #fef3c7;
  color: #92400e;
  font-size: 24rpx;
}
.price {
  color: #16a34a;
  font-size: 34rpx;
  font-weight: 700;
}

.tips {
  margin-top: 40rpx;
  color: #78350f;
  font-size: 24rpx;
  line-height: 1.6;
  opacity: 0.75;
}
