/* components/privacy-popup —— 全局隐私授权弹窗（极简灰蓝） */
.privacy-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}
.privacy-dialog {
  width: 100%;
  max-width: 560rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 48rpx 40rpx 32rpx;
  box-sizing: border-box;
}
.privacy-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
  text-align: center;
  margin-bottom: 24rpx;
}
.privacy-content {
  font-size: 26rpx;
  color: var(--text-muted);
  line-height: 1.7;
  text-align: left;
}
.privacy-link {
  color: var(--primary-color);
}
.privacy-btns {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}
.privacy-btn {
  flex: 1;
  min-height: 80rpx;
  line-height: 80rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}
.privacy-btn::after { border: none; }
.privacy-btn-cancel {
  background: #f7f8fa;
  color: var(--text-muted);
}
.privacy-btn-confirm {
  background: var(--primary-color);
  color: #ffffff;
}
