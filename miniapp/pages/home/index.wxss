/* ============================================================
 * pages/home/index.wxss  —— 首页大盘
 * 色彩策略：复用全局 --primary-color / --primary-light
 * ==========================================================*/

page {
  background: #fff8f3;
}

.home-page {
  padding-bottom: 48rpx;
}

/* ---------- 轮播 ---------- */
.swiper-wrap {
  margin: 24rpx 24rpx;
}
.banner {
  width: 100%;
  height: 360rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 28rpx rgba(255, 122, 51, 0.15);
}
.banner-img {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 24rpx;
}
.banner-title {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  padding: 16rpx 28rpx 20rpx;
  background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.5) 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-bottom-left-radius: 24rpx;
  border-bottom-right-radius: 24rpx;
}
.banner-placeholder {
  width: 100%; height: 100%;
  background: var(--primary-gradient);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #fff;
  padding: 0 40rpx;
  box-sizing: border-box;
}
.ph-title { font-size: 40rpx; font-weight: 800; margin-bottom: 12rpx; }
.ph-sub   { font-size: 26rpx; opacity: 0.92; }

/* ---------- 宫格区 ---------- */
.grid-section {
  margin: 8rpx 24rpx 0;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #9a3412;
  padding: 12rpx 4rpx 20rpx;
}
.grid-2 {
  display: flex;
  justify-content: space-between;
  align-items: stretch;
  gap: 24rpx;
}
.grid-card {
  flex: 1;
  background: #ffffff;
  border: 1rpx solid var(--primary-light);
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 122, 51, 0.08);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-height: 240rpx;
  box-sizing: border-box;
}
.grid-card-hover {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(255, 122, 51, 0.06);
  opacity: 0.95;
}
.grid-icon {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 44rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}
.grid-icon-primary {
  background: var(--primary-light);
}
.grid-icon-secondary {
  background: #fff4e0;
}
.grid-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 8rpx;
}
.grid-desc {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
}

.home-tips {
  margin: 40rpx 28rpx 0;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.7;
}

/* ========== 商户端：全屏大扫码 ========== */
.merchant-wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 48rpx;
  box-sizing: border-box;
}
.merchant-greeting {
  text-align: center;
  margin-bottom: 80rpx;
}
.merchant-hello {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
}
.merchant-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.scan-btn {
  width: 480rpx;
  height: 480rpx;
  border-radius: 50%;
  background: var(--primary-gradient);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 60rpx rgba(255, 122, 51, 0.4);
  transition: transform 0.15s;
}
.scan-btn-hover {
  transform: scale(0.96);
}
.scan-icon {
  font-size: 140rpx;
  line-height: 1;
  margin-bottom: 16rpx;
}
.scan-text {
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 4rpx;
}
.scan-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}
.merchant-tip {
  margin-top: 64rpx;
  font-size: 26rpx;
  color: #9ca3af;
  text-align: center;
}
