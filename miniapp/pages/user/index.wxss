/* ===== pages/user/index.wxss（补充全局 app.wxss 没覆盖的） ===== */

/* 顶部用户资料区（纯白卡片，替代旧渐变色块） */
.header-bg {
  margin: 0 -32rpx 0;      /* 抵消 .page padding，左右贯通 */
  padding: 48rpx 40rpx 40rpx;
  background: #ffffff;
  border-bottom-left-radius: 16rpx;
  border-bottom-right-radius: 16rpx;
  color: var(--text-main);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 上部：用户资料（头像 + 姓名/标签） */
.user-profile {
  display: flex;
  align-items: center;
}
.user-profile .avatar {
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  flex-shrink: 0;
}
.profile-info {
  flex: 1;
  margin-left: 28rpx;
  min-width: 0;
}
.profile-info .name {
  color: var(--text-main);
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.profile-tags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.profile-tag {
  background: var(--primary-light);
  color: var(--primary-color);
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

/* 下部：核心资产横向双栏（浅蓝底卡片） */
.user-assets {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 40rpx;
  background: var(--primary-light);
  border-radius: 16rpx;
  padding: 30rpx 0;
}
.asset-block {
  flex: 1;
  text-align: center;
  color: var(--text-main);
  min-width: 0;
}
.asset-label {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 10rpx;
}
.asset-value {
  font-size: 48rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
  line-height: 1.1;
  color: var(--primary-color);
}
.asset-divider {
  width: 1rpx;
  height: 64rpx;
  background: #d6e4f5;
  flex-shrink: 0;
}

/* 菜单列表（白色卡片） */
.menu-card {
  margin-top: 28rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 0 32rpx;
  border: 1rpx solid #eef0f3;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #eef0f3;
}
.menu-item:last-child {
  border-bottom: 0;
}
.menu-item-hover {
  background: var(--primary-light);
  margin: 0 -32rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
}
.menu-icon {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  background: var(--primary-light);
  border-radius: 14rpx;
}
.menu-label {
  flex: 1;
  color: var(--text-main);
  font-size: 30rpx;
  font-weight: 500;
}
.menu-arrow {
  color: var(--text-muted);
  font-size: 44rpx;
  line-height: 1;
  font-weight: 300;
}
