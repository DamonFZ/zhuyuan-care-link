<view class="page">
  <!-- 顶部深灰蓝沉浸式头部（用户资料 + 核心资产数据） -->
  <view class="header-bg">
    <view class="user-profile">
      <image
        class="avatar"
        src="{{avatarUrl || '/assets/icons/user-active.png'}}"
        mode="aspectFill"
        bindtap="onEditProfile"
      ></image>
      <view class="profile-info">
        <view class="name">{{userInfo.name || '微信用户'}}</view>
        <view class="profile-tags">
          <text class="profile-tag">{{roleText}}</text>
          <text class="profile-tag">{{volunteerLevelName}}</text>
        </view>
      </view>
    </view>

    <block wx:if="{{loginReady && !loginError}}">
      <view class="user-assets">
        <view class="asset-block">
          <view class="asset-label">消费金余额(元)</view>
          <view class="asset-value">¥ {{points}}</view>
        </view>
        <view class="asset-divider"></view>
        <view class="asset-block">
          <view class="asset-label">累计志愿时长(时)</view>
          <view class="asset-value">{{volunteerHours}}</view>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{!loginReady}}" class="card card-loading">
    <view style="color: var(--primary-color);">⏳ 正在用微信账号自动登录…</view>
  </view>

  <view wx:elif="{{loginError}}" class="card card-error">
    <view class="err-title">登录受阻</view>
    <view class="err-msg">{{loginError}}</view>
    <button class="btn" bindtap="onRetryLogin">重新登录</button>
  </view>

  <!-- 登录成功：仅保留菜单 -->
  <block wx:else>
    <!-- 菜单列表：编辑个人信息等 -->
    <view class="menu-card">
      <view class="menu-item" bindtap="onEditProfile" hover-class="menu-item-hover">
        <view class="menu-icon">✏️</view>
        <view class="menu-label">编辑个人信息</view>
        <view class="menu-arrow">›</view>
      </view>

      <view class="menu-item" bindtap="onPointsTap" hover-class="menu-item-hover">
        <view class="menu-icon">💳</view>
        <view class="menu-label">消费金流水</view>
        <view class="menu-arrow">›</view>
      </view>

      <view class="menu-item" bindtap="onVolunteerTap" hover-class="menu-item-hover">
        <view class="menu-icon">🙋</view>
        <view class="menu-label">志愿服务记录</view>
        <view class="menu-arrow">›</view>
      </view>

      <view class="menu-item" bindtap="onLogout" hover-class="menu-item-hover">
        <view class="menu-icon">🚪</view>
        <view class="menu-label">退出登录</view>
        <view class="menu-arrow">›</view>
      </view>
    </view>
  </block>

  <view class="user-slogan">We care, we share</view>
</view>
