<view class="page">
  <!-- 顶部绿色横幅 Hero（含头像） -->
  <view class="hero hero-profile">
    <image
      class="hero-avatar"
      src="{{avatarUrl || '/assets/icons/user-active.png'}}"
      mode="aspectFill"
      bindtap="onEditProfile"
    ></image>
    <view class="hero-text">
      <view class="hero-title">{{userInfo.name || '微信用户'}}</view>
      <view class="hero-sub">{{roleText}} · {{volunteerLevelName}}</view>
    </view>
  </view>

  <view wx:if="{{!loginReady}}" class="card card-loading">
    <view style="color: var(--primary-color);">⏳ 正在用微信账号自动登录…</view>
  </view>

  <view wx:elif="{{loginError}}" class="card card-error">
    <view class="err-title">登录受阻</view>
    <view class="err-msg">{{loginError}}</view>
    <button class="btn" bindtap="onRetryLogin">重新登录</button>
  </view>

  <!-- 登录成功：Dashboard -->
  <block wx:else>
    <!-- 消费金资产卡 -->
    <view class="card" style="border: 2rpx solid var(--primary-color); box-shadow: 0 8rpx 28rpx rgba(125,214,26,0.16);">
      <view class="row" style="border-bottom: none; padding: 0 0 8rpx;">
        <text class="k" style="font-size: 28rpx; font-weight: 600;">💰 消费金余额</text>
        <text class="v" style="color: var(--primary-color);">可核销</text>
      </view>
      <view style="margin-top: 8rpx;">
        <text class="price" style="font-size: 60rpx;">¥ {{points}}</text>
        <text class="v" style="color: var(--text-muted); margin-left: 12rpx;">CNY</text>
      </view>
    </view>

    <!-- 身份信息卡 -->
    <view class="card">
      <view class="row">
        <text class="k">🙋 姓名</text>
        <text class="v">{{userInfo.name || '微信用户'}}</text>
      </view>
      <view class="row">
        <text class="k">🛡 角色</text>
        <text class="v tag role">{{roleText}}</text>
      </view>
      <view class="row">
        <text class="k" style="color: var(--primary-color);">🎖 志愿者等级</text>
        <text class="v" style="color: var(--primary-color); font-weight: 700;">{{volunteerLevelName}}</text>
      </view>
      <view class="row" style="border-bottom: none;">
        <text class="k">⏱ 累计时长</text>
        <text class="v">{{userInfo.volunteer_hours || '0.0'}} 小时</text>
      </view>
    </view>

    <!-- 菜单列表：编辑个人信息等 -->
    <view class="menu-card">
      <view class="menu-item" bindtap="onEditProfile" hover-class="menu-item-hover">
        <view class="menu-icon">✏️</view>
        <view class="menu-label">编辑个人信息</view>
        <view class="menu-arrow">›</view>
      </view>

      <view class="menu-item" bindtap="onPointsTap" hover-class="menu-item-hover">
        <view class="menu-icon">💳</view>
        <view class="menu-label">消费金流水</view>
        <view class="menu-arrow">›</view>
      </view>

      <view class="menu-item" bindtap="onLogout" hover-class="menu-item-hover">
        <view class="menu-icon">🚪</view>
        <view class="menu-label">退出登录</view>
        <view class="menu-arrow">›</view>
      </view>
    </view>
  </block>

  <view class="tips" style="color: var(--text-muted);">
    Tips：消费金来源于「志愿服务」「旧衣回收」等公益活动，可在社区合作商户核销。
  </view>
</view>
