<view class="volunteer-page">
  <!-- 加载中 -->
  <view wx:if="{{loading && list.length === 0}}" class="loading-wrap">
    <view class="loading-text">加载中…</view>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{!loading && list.length === 0}}" class="empty-wrap">
    <view class="empty-emoji">🙋</view>
    <view class="empty-text">暂无志愿记录</view>
    <view class="empty-sub">扫码参与社区志愿活动后，打卡记录将在此展示</view>
  </view>

  <!-- 打卡记录列表 -->
  <block wx:else>
    <view class="att-card" wx:for="{{list}}" wx:key="id">
      <!-- 卡片头部：活动名 + 状态标签 -->
      <view class="att-header">
        <view class="att-title">{{item.activity ? item.activity.title : '未知活动'}}</view>
        <view class="att-status {{item.status === 'completed' ? 'status-done' : 'status-doing'}}">
          {{item.status === 'completed' ? '已签退' : '打卡中'}}
        </view>
      </view>

      <!-- 卡片主体：签到 / 签退时间 -->
      <view class="att-body">
        <view class="att-row">
          <text class="att-row-label">签到：</text>
          <text class="att-row-value">{{item.check_in_time || '-'}}</text>
        </view>
        <view class="att-row">
          <text class="att-row-label">签退：</text>
          <text class="att-row-value">{{item.check_out_time || '待签退'}}</text>
        </view>
      </view>

      <!-- 卡片底部：服务时长（仅已签退时展示） -->
      <view wx:if="{{item.status === 'completed' && item.service_hours !== null}}" class="att-footer">
        <view class="att-hours">服务时长 {{item.service_hours}} 小时</view>
      </view>
      <view wx:if="{{item.remark}}" class="att-remark">备注：{{item.remark}}</view>
    </view>

    <!-- 加载更多 / 没有更多 -->
    <view class="load-more">
      <view wx:if="{{loadingMore}}" class="load-more-text">加载中…</view>
      <view wx:elif="{{!hasMore}}" class="load-more-text no-more">— 没有更多了 —</view>
    </view>
  </block>
</view>
