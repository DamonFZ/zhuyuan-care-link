<view class="points-page">
  <!-- 加载中 -->
  <view wx:if="{{loading && list.length === 0}}" class="loading-wrap">
    <view class="loading-text">加载中…</view>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{!loading && list.length === 0}}" class="empty-wrap">
    <icon type="info" size="80" color="#d1d5db" class="empty-icon" />
    <view class="empty-text">暂无流水记录</view>
    <view class="empty-sub">完成志愿服务或旧衣回收后，消费金变动将在此展示</view>
  </view>

  <!-- 流水列表 -->
  <block wx:else>
    <view class="tx-card" wx:for="{{list}}" wx:key="id">
      <view class="tx-left">
        <view class="tx-title">{{item.event_name}}</view>
        <view class="tx-time">{{item.created_at}}</view>
      </view>
      <view class="tx-right">
        <view class="tx-amount {{item.amount > 0 ? 'amount-in' : 'amount-out'}}">
          {{item.amount > 0 ? '+' : ''}}{{item.amount_display}}
        </view>
        <view class="tx-balance">余额 ¥{{item.new_points}}</view>
      </view>
    </view>

    <!-- 加载更多 / 没有更多 -->
    <view class="load-more">
      <view wx:if="{{loadingMore}}" class="load-more-text">加载中…</view>
      <view wx:elif="{{!hasMore}}" class="load-more-text no-more">— 没有更多了 —</view>
    </view>
  </block>
</view>
