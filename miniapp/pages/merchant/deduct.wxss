/* pages/merchant/deduct.wxss —— 商户扣款页 */
.deduct-page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

/* 被核销用户信息卡 */
.target-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  border: 1rpx solid #eef0f3;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.target-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 3rpx solid var(--primary-color);
  background: #fff;
  flex-shrink: 0;
}
.target-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}
.target-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}
.target-balance {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-muted);
}
.balance-num {
  color: var(--primary-color);
  font-weight: 700;
  font-size: 30rpx;
}

/* 金额输入 */
.amount-section {
  margin-top: 36rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 36rpx 32rpx;
  border: 1rpx solid #eef0f3;
}
.amount-label {
  font-size: 28rpx;
  color: var(--primary-color);
  font-weight: 700;
  margin-bottom: 20rpx;
}
.amount-input-wrap {
  display: flex;
  align-items: baseline;
  border-bottom: 4rpx solid var(--primary-color);
  padding: 12rpx 0;
}
.amount-unit {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--primary-color);
  margin-right: 12rpx;
}
.amount-input {
  flex: 1;
  font-size: 72rpx;
  font-weight: 800;
  color: var(--text-main);
  letter-spacing: 2rpx;
}
.amount-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}
.quick-amount {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}
.quick-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: var(--primary-light);
  color: var(--primary-color);
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* 扣款按钮 */
.btn-deduct {
  margin-top: 56rpx;
  width: 100%;
  min-height: 96rpx;
  line-height: 96rpx;
  border-radius: 16rpx;
  background: var(--primary-color);
  color: #ffffff !important;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  box-shadow: 0 4rpx 16rpx rgba(59, 98, 145, 0.2);
  border: none;
}
.btn-deduct[disabled] {
  opacity: 0.6;
  color: #fff !important;
}
.btn-deduct::after { border: none; }

.deduct-tip {
  margin-top: 28rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b91c1c;
}
