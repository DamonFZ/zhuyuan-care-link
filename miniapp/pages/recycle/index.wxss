/* pages/recycle/index.wxss —— 上门回收预约表单（极简灰蓝） */
page {
  background: var(--bg-page);
}

.recycle-page {
  padding: 24rpx 24rpx 160rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 表单卡片 */
.form-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #eef0f3;
}
.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 24rpx;
}

/* 重量选择按钮 */
.weight-options {
  display: flex;
  gap: 20rpx;
}
.weight-btn {
  flex: 1;
  background: #f7f8fa;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 28rpx 0;
  text-align: center;
  transition: all 0.15s;
}
.weight-btn.active {
  background: var(--primary-light);
  border-color: var(--primary-color);
}
.weight-main {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}
.weight-btn.active .weight-main {
  color: var(--primary-color);
}
.weight-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}
.weight-btn.active .weight-sub {
  color: var(--primary-color);
  opacity: 0.8;
}

/* 时间选择行 */
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eef0f3;
}
.picker-row:last-child {
  border-bottom: 0;
}
.picker-label {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
}
.picker-value {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: var(--text-muted);
}
.picker-value text:first-child {
  color: var(--text-main);
}
.picker-icon {
  font-size: 28rpx;
}

/* 图片上传 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.image-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.image-thumb {
  width: 100%;
  height: 100%;
  display: block;
}
.image-delete {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  border-radius: 50%;
  font-size: 24rpx;
}
.image-add {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed #d1d5db;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f7f8fa;
}
.image-add-icon {
  font-size: 56rpx;
  color: #9ca3af;
  line-height: 1;
}
.image-add-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}
.upload-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--primary-color);
}

/* 备注输入 */
.remark-input {
  width: 100%;
  min-height: 140rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: var(--text-main);
  box-sizing: border-box;
}

/* 提交按钮 */
.submit-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}
.submit-btn {
  width: 100%;
  min-height: 96rpx;
  line-height: 96rpx;
  background: var(--primary-color);
  color: #ffffff !important;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 16rpx;
  border: none;
  letter-spacing: 4rpx;
  box-shadow: 0 4rpx 16rpx rgba(59, 98, 145, 0.2);
}
.submit-btn.disabled {
  opacity: 0.6;
}
.submit-btn::after { border: none; }
